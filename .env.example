# Postgres. Railway exposes two URLs per database service:
#   DATABASE_URL         private network, no TLS — use this from the deployed app
#   DATABASE_PUBLIC_URL  public proxy, TLS required — use this from your laptop
# db/connection.mjs picks the right SSL mode by inspecting the host, so paste
# whichever one matches where the command is running.
#
# Leave it unset and the app serves the bundled JSON catalog instead, which is
# how a fresh clone runs with no database at all.
DATABASE_URL=

# Absolute origin, used for canonical URLs, Open Graph tags and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Gemini Vision — powers photo-match and the parts generator. Without it those
# two features return 503 and the UI shows them as disabled.
GEMINI_API_KEY=

# Tripo3D image-to-3D. Without it /api/generate-3d falls back to a 2.5D
# billboard instead of a generated mesh.
TRIPO3D_API_KEY=
