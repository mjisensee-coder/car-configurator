# Postgres. Railway exposes two URLs per database service:
#   DATABASE_URL         private network, no TLS — use this from the deployed app
#   DATABASE_PUBLIC_URL  public proxy, TLS required — use this from your laptop
# db/connection.mjs picks the right SSL mode by inspecting the host, so paste
# whichever one matches where the command is running.
#
# Leave it unset and the app serves the bundled JSON catalog instead, which is
# how a fresh clone runs with no database at all.
DATABASE_URL=

# Absolute origin, used for canonical URLs, Open Graph tags and sitemap.xml.
#
# Set this on the deployment. It has to be present at BUILD time, because
# those URLs are baked into the statically generated pages — the Dockerfile
# declares it as an ARG so a Railway/Docker service variable reaches
# `next build`. Left unset, the app falls back to RAILWAY_PUBLIC_DOMAIN,
# then VERCEL_PROJECT_PRODUCTION_URL, then localhost.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Gemini Vision — powers photo-match and the parts generator. Without it those
# two features return 503 and the UI shows them as disabled.
GEMINI_API_KEY=

# Image-to-3D backends for /api/generate-3d. It prefers fal.ai TRELLIS
# (~$0.02/run), falls back to Tripo3D (~$0.30/run), then to a 2.5D
# billboard when neither key is set.
FAL_KEY=
# Override the fal.ai model if you want a different mesh generator.
# FAL_MODEL_ID=fal-ai/trellis
TRIPO3D_API_KEY=
